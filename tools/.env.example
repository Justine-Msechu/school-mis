# Auto-Fix Agent — environment variables
# Copy this file to  tools/.env  and fill in real values.
# Source it before running:  source tools/.env

# Claude API key (get from https://console.anthropic.com)
export ANTHROPIC_API_KEY="sk-ant-..."

# Where the School MIS is running
# Local Docker stack:  http://localhost
# Production domain:   https://maarifahub.co.tz
export MIS_API_URL="http://localhost"

# Superadmin credentials (used to fetch error logs and authenticate)
export MIS_SUPERADMIN_USER="your_superadmin_username"
export MIS_SUPERADMIN_PASS="your_superadmin_password"

# Optional tuning
# export AUTOFIX_MAX_PER_RUN=1       # max errors to attempt per run (default 1)
# export AUTOFIX_RETRY_HOURS=24      # hours before retrying a failed error
# export AUTOFIX_MIN_CONFIDENCE=0.75 # minimum Claude confidence to apply a fix
