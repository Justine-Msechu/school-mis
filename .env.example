# ─────────────────────────────────────────────────────────────────
# School MIS — Environment variables template
# Copy this file to .env and fill in real values before deploying.
# .env is gitignored — never commit it.
# ─────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────
POSTGRES_USER=school_mis
POSTGRES_DB=school_mis
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password

# Built automatically from the three vars above — do not edit this line.
DATABASE_URL=postgresql://school_mis:CHANGE_ME_strong_random_password@postgres:5432/school_mis

# ── Security ──────────────────────────────────────────────────────
# Used to sign fee control numbers. Run: python3 -c "import secrets; print(secrets.token_urlsafe(40))"
FINANCE_HMAC_KEY=CHANGE_ME_generate_with_command_above

# ── AI features (optional) ────────────────────────────────────────
# Get your key from https://console.anthropic.com
# Leave blank to disable AI features.
ANTHROPIC_API_KEY=

# ── Payment gateways (optional) ───────────────────────────────────
# Flutterwave — leave blank to disable
FLW_SECRET_KEY=
FLW_PUBLIC_KEY=
FLW_WEBHOOK_SECRET=

# Paystack — leave blank to disable
PAYSTACK_SECRET_KEY=
